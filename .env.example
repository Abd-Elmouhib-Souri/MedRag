# ── Required ───────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here          # free key: https://console.groq.com

# ── Optional (defaults shown) ───────────────────────────────────────────────
# DATA_DIR=<project>/data               # chroma_db, summaries, uploads, models live here
# MODEL_FAST=openai/gpt-oss-20b         # query rewriting + grounding judge
# MODEL_STRONG=openai/gpt-oss-120b      # clinical answers
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3   # multilingual cross-encoder; fast option: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RELEVANCE_THRESHOLD=0.0034            # calibrate: python -m scripts.evaluate --calibrate --rewrite
# RERANK_TOP_N=8                        # chunks scored by the cross-encoder (latency cap)
# GROUNDING_CHECK=true
# WEIGHT_DENSE=0.7
# WEIGHT_BM25=0.3
# MAX_UPLOAD_MB=20
# LOG_LEVEL=INFO
